    "test": "node test/patch.mjs && node test/harness.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm",
    "fallback",
    "failover",
    "router"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
